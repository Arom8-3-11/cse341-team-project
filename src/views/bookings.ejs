<%- include('./partials/header') %>

<section class="bookings-admin">
    <h1>Bookings Admin</h1>
    <p>All bookings made through the Kizuna Rail site, loaded from the bookings API.</p>

    <div class="trips-state" id="bookings-loading">Loading bookings...</div>
    <div class="trips-state trips-error" id="bookings-error" hidden></div>
    <div class="trips-state" id="bookings-empty" hidden>There are no bookings yet.</div>

    <div class="bookings-grid" id="bookings-list"></div>

    <template id="booking-card-template">
        <article class="booking-card">
            <header class="booking-card-header">
                <h2 data-field="id"></h2>
                <span class="booking-created" data-field="created"></span>
            </header>

            <dl class="booking-specs">
                <div class="spec-item">
                    <dt>Trip</dt>
                    <dd data-field="trip"></dd>
                </div>
                <div class="spec-item">
                    <dt>Schedule</dt>
                    <dd data-field="schedule"></dd>
                </div>
                <div class="spec-item">
                    <dt>Ticket Class</dt>
                    <dd data-field="ticket-class"></dd>
                </div>
                <div class="spec-item">
                    <dt>Travel Day</dt>
                    <dd data-field="day"></dd>
                </div>
            </dl>

            <div class="booking-passengers">
                <h3>Passengers</h3>
                <ul data-field="passengers"></ul>
            </div>

            <a href="#" class="view-details-btn" data-field="confirmation-link">View Confirmation &#8594;</a>
        </article>
    </template>
</section>

<%- include('./partials/footer') %>
